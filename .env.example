# =============================================================================
# ESTE É O ARQUIVO DE EXEMPLO. NÃO EDITE ELE DIRETAMENTE.
#
# Faça uma CÓPIA com o nome ".env" e edite a cópia:
#
#   Mac / Linux:   cp .env.example .env
#   Windows:       copy .env.example .env
#
# ⚠️ COPIE, não renomeie! Se você renomear, o próximo aluno que baixar o
#    projeto não vai encontrar este modelo.
#
# ⚠️ O arquivo .env NUNCA deve ir para o GitHub (já está no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# NGROK — cria o túnel público até o seu n8n local
# -----------------------------------------------------------------------------

# Pegue em: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=cole_seu_authtoken_aqui

# Pegue em: https://dashboard.ngrok.com/domains (crie um domínio grátis)
# Use SOMENTE o domínio, sem "https://" e sem barra no final.
# Exemplo correto:  meu-agente-vendas.ngrok-free.dev
NGROK_DOMAIN=seu-dominio.ngrok-free.dev

# -----------------------------------------------------------------------------
# POSTGRES — opcional, só para memória persistente
# (usado apenas com: docker compose --profile persistente up -d)
# -----------------------------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=n8n_memoria
